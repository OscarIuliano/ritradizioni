---
import { Image } from 'astro:assets';
import { images } from '../assets/images';
import type { Content } from '../i18n/types';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const h = t.houses;
---

<section class="section alt" id="case">
  <div class="wrap">
    <div class="section-head">
      <h2>{h.title}</h2>
      <p>{h.intro}</p>
    </div>

    <div class="houses">
      {
        h.items.map((house) => (
          <article class="house">
            <Image src={images[house.image]} alt={house.name} widths={[600, 1000]} sizes="(max-width: 820px) 100vw, 560px" />
            <div class="body">
              <h3>{house.name}</h3>
              <span class="beds">{house.beds}</span>
              <p>{house.text}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="people">
      <Image src={images[t.people.image]} alt="" widths={[600, 1000]} sizes="(max-width: 820px) 100vw, 560px" />
      <div class="people-body">
        <h3>{t.people.title}</h3>
        <p>{t.people.text}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .alt {
    background: var(--sand);
  }
  .houses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .house {
    background: var(--paper);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .house img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .body {
    padding: 1.4rem 1.5rem 1.6rem;
  }
  .body h3 {
    margin-bottom: 0.4rem;
  }
  .beds {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--cream);
    color: var(--olive-dark);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.8rem;
  }
  .body p {
    margin: 0;
    color: var(--muted);
  }
  .people {
    margin-top: clamp(3rem, 7vw, 5rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  .people img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .people h3 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
  }
  .people p {
    font-size: 1.15rem;
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .people {
      grid-template-columns: 1fr;
    }
  }
</style>
