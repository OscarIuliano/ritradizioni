---
import { Image } from 'astro:assets';
import { images } from '../assets/images';
import type { Content } from '../i18n/types';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section class="hero">
  <Image
    class="bg"
    src={images[t.hero.image]}
    alt=""
    widths={[800, 1400, 1800]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="shade"></div>
  <div class="wrap content">
    <span class="eyebrow">{t.hero.eyebrow}</span>
    <h1>{t.hero.title}</h1>
    <p>{t.hero.text}</p>
    <div class="ctas">
      <a class="btn btn-primary" href="#settimana">{t.hero.primary}</a>
      <a class="btn btn-ghost" href="#contatti">{t.hero.secondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(20, 18, 12, 0.45) 0%, rgba(20, 18, 12, 0) 65%),
      linear-gradient(180deg, rgba(20, 18, 12, 0) 25%, rgba(20, 18, 12, 0.72) 100%);
  }
  .content {
    position: relative;
    padding-block: clamp(3rem, 10vh, 6rem);
  }
  .eyebrow {
    color: #fff;
    opacity: 0.9;
  }
  h1 {
    font-size: clamp(2.4rem, 6.5vw, 4.6rem);
    max-width: 15ch;
    margin-bottom: 1.2rem;
  }
  p {
    max-width: 56ch;
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: rgba(255, 255, 255, 0.92);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
</style>
