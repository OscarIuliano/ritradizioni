---
import { Image } from 'astro:assets';
import { images } from '../assets/images';
import type { Content } from '../i18n/types';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section class="section alt" id="persone">
  <div class="wrap people">
    <Image src={images[t.people.image]} alt="" widths={[600, 1000]} sizes="(max-width: 820px) 100vw, 560px" />
    <div>
      <h2>{t.people.title}</h2>
      <p>{t.people.text}</p>
    </div>
  </div>
</section>

<style>
  .alt {
    background: var(--sand);
  }
  .people {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  .people img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .people p {
    font-size: 1.15rem;
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .people {
      grid-template-columns: 1fr;
    }
  }
</style>
