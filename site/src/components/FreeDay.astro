---
import { Image } from 'astro:assets';
import { images } from '../assets/images';
import type { Content } from '../i18n/types';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const d = t.freeDay;
---

<section class="section">
  <div class="wrap grid">
    <div>
      <span class="eyebrow">{t.formula.kinds.free.label}</span>
      <h2>{d.title}</h2>
      <p class="intro">{d.intro}</p>
      <ul class="places">
        {
          d.places.map((place) => (
            <li>
              <strong>{place.name}</strong>
              <span>{place.text}</span>
            </li>
          ))
        }
      </ul>
      <p class="note">{d.note}</p>
    </div>
    <Image src={images[d.image]} alt="" widths={[600, 1000]} sizes="(max-width: 820px) 100vw, 520px" />
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .eyebrow {
    color: var(--sea);
  }
  .intro {
    font-size: 1.15rem;
    color: var(--muted);
  }
  .places {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 1rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .places li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.1rem;
    border-radius: 14px;
    background: var(--paper);
    border-left: 4px solid var(--sea);
  }
  .places strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .places span {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .note {
    color: var(--muted);
    font-size: 0.95rem;
  }
  img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .places {
      grid-template-columns: 1fr;
    }
    img {
      aspect-ratio: 3 / 2;
    }
  }
</style>
