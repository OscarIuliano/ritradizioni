---
import { Image } from 'astro:assets';
import { images } from '../assets/images';
import type { Content } from '../i18n/types';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const e = t.experiences;
---

<section class="section alt">
  <div class="wrap">
    <div class="section-head">
      <h2>{e.title}</h2>
      <p>{e.intro}</p>
    </div>
    <div class="grid">
      {
        e.items.map((item) => (
          <article class="card">
            <Image src={images[item.image]} alt={item.title} widths={[480, 800]} sizes="(max-width: 820px) 100vw, 380px" />
            <div class="body">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .alt {
    background: var(--sand);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .card {
    background: var(--paper);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .body {
    padding: 1.4rem 1.5rem 1.6rem;
  }
  .body p {
    margin: 0;
    color: var(--muted);
  }
</style>
