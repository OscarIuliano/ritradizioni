---
import { Image } from 'astro:assets';
import { images } from '../assets/images';
import type { Content } from '../i18n/types';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const s = t.seasons;
---

<section class="section" id="stagioni">
  <div class="wrap">
    <div class="section-head">
      <h2>{s.title}</h2>
      <p>{s.intro}</p>
    </div>

    <div class="seasons" data-seasons>
      <div class="tabs" role="tablist">
        {
          s.items.map((item, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${item.id}`}
              aria-controls={`panel-${item.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-season={item.id}
            >
              <span class="tab-name">{item.name}</span>
              <span class="tab-months">{item.months}</span>
            </button>
          ))
        }
      </div>

      {
        s.items.map((item, i) => (
          <article
            class="panel"
            role="tabpanel"
            id={`panel-${item.id}`}
            aria-labelledby={`tab-${item.id}`}
            data-panel={item.id}
            hidden={i !== 0}
          >
            <Image src={images[item.image]} alt={item.title} widths={[600, 1000]} sizes="(max-width: 820px) 100vw, 560px" />
            <div class="panel-body">
              <span class="eyebrow">
                {item.name} · {item.months}
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <div class="take-home">
                <span>{s.takeHomeLabel}</span>
                <strong>{item.takeHome}</strong>
              </div>
            </div>
          </article>
        ))
      }
    </div>
    <p class="note">{s.note}</p>
  </div>
</section>

<script>
  // Stagione di partenza: quella del mese corrente.
  const seasonByMonth = [
    'winter', 'winter', 'spring', 'spring', 'spring', 'summer',
    'summer', 'summer', 'summer', 'autumn', 'autumn', 'winter',
  ];

  document.querySelectorAll<HTMLElement>('[data-seasons]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-season]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];

    const select = (id: string) => {
      tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.season === id)));
      panels.forEach((panel) => (panel.hidden = panel.dataset.panel !== id));
    };

    tabs.forEach((tab) => tab.addEventListener('click', () => select(tab.dataset.season!)));
    select(seasonByMonth[new Date().getMonth()]);
  });
</script>

<style>
  .tabs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }
  .tabs button {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    padding: 0.9rem 1.1rem;
    border: 2px solid var(--line);
    border-radius: 14px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .tabs button:hover {
    border-color: var(--terracotta);
  }
  .tabs button[aria-selected='true'] {
    background: var(--terracotta);
    border-color: var(--terracotta);
    color: #fff;
  }
  .tab-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .tab-months {
    font-size: 0.82rem;
    opacity: 0.8;
  }
  .panel {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    background: var(--paper);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .panel[hidden] {
    display: none;
  }
  .panel img {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
  }
  .panel-body {
    padding: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .panel-body h3 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .panel-body p {
    color: var(--muted);
  }
  .take-home {
    margin-top: 1rem;
    padding: 1rem 1.2rem;
    border-radius: 12px;
    background: var(--cream);
    border-left: 4px solid var(--olive);
    display: flex;
    flex-direction: column;
  }
  .take-home span {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--olive);
  }
  .take-home strong {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
  }
  .note {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  @media (max-width: 820px) {
    .tabs {
      grid-template-columns: repeat(2, 1fr);
    }
    .panel {
      grid-template-columns: 1fr;
    }
    .panel img {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
  }
</style>
