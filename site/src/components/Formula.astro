---
import type { Content, DayKind } from '../i18n/types';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const f = t.formula;
const kinds = Object.keys(f.kinds) as DayKind[];
---

<section class="section" id="settimana">
  <div class="wrap">
    <div class="section-head">
      <h2>{f.title}</h2>
      <p>{f.intro}</p>
    </div>

    <ul class="kinds">
      {
        kinds.map((k) => (
          <li class={`kind kind-${k}`}>
            <span class="count">{f.kinds[k].count}</span>
            <div>
              <h3>{f.kinds[k].label}</h3>
              <p>{f.kinds[k].text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <h3 class="example">{f.exampleTitle}</h3>
    <ol class="days">
      {
        f.days.map((d, i) => (
          <li class={`day kind-${d.kind}`}>
            <span class="day-num">
              {f.dayLabel} {i + 1}
            </span>
            <span class="day-title">{d.title}</span>
            <span class="day-kind">{f.kinds[d.kind].tag}</span>
          </li>
        ))
      }
      <li class="day extra">
        <span class="day-num">+</span>
        <span class="day-title">{f.extra.title}</span>
        <span class="day-kind">{f.extra.text}</span>
      </li>
    </ol>

    <div class="bottom">
      <p class="note">{f.note}</p>
      <div class="price">
        <span class="price-label">{f.price.label}</span>
        <p class="price-main">
          <span class="price-from">{f.price.from}</span>
          <strong>{f.price.amount}</strong>
        </p>
        <span class="price-unit">{f.price.unit}</span>
        <span class="price-children">{f.price.children}</span>
        <a class="btn btn-primary" href="#contatti">{f.price.cta}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .kinds {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .kind {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    padding: 1.5rem;
    background: var(--paper);
    border-radius: var(--radius);
    border-top: 5px solid var(--kind);
  }
  .count {
    font-family: var(--font-display);
    font-size: 3.2rem;
    line-height: 1;
    font-weight: 600;
    color: var(--kind);
  }
  .kind h3 {
    font-size: 1.2rem;
    margin-bottom: 0.3rem;
  }
  .kind p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
  }
  .days {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.6rem;
  }
  .day {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1rem 1.2rem;
    border-radius: 14px;
    background: var(--kind);
    color: #fff;
    min-height: 150px;
  }
  .day-num {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .day-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.2;
    font-weight: 600;
  }
  .day-kind {
    margin-top: auto;
    font-size: 0.8rem;
    opacity: 0.85;
  }
  .example {
    font-size: 1.1rem;
    margin-bottom: 0.9rem;
  }
  .extra {
    background: #f8e4d8;
    color: var(--terracotta-dark);
    border: 2px dashed var(--terracotta);
  }
  .extra .day-num {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--terracotta);
    color: #fff;
    font-size: 1.3rem;
    letter-spacing: 0;
    line-height: 1;
    opacity: 1;
  }
  .extra .day-kind {
    color: var(--ink);
    opacity: 1;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .note {
    flex: 1 1 280px;
    margin: 0;
    color: var(--muted);
  }
  .price {
    flex: 0 1 340px;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.4rem 1.6rem;
    background: var(--paper);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .price-label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  .price-main {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .price-from {
    color: var(--muted);
  }
  .price-main strong {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .price-unit {
    font-weight: 600;
  }
  .price-children {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .price .btn {
    align-self: flex-start;
    margin-top: 0.8rem;
  }
  @media (max-width: 820px) {
    .days {
      grid-template-columns: 1fr;
    }
    .day {
      min-height: 0;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: 1rem;
    }
    .day-kind {
      margin-top: 0;
      margin-left: auto;
    }
  }
</style>
