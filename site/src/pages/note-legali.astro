---
import LegalLayout from '../layouts/LegalLayout.astro';
import { legal } from '../config/legal';
---

<LegalLayout lang="it" title="Note legali" alternates={{ it: '/note-legali/', en: '/en/legal-notice/' }}>
  <h2>Titolare del sito</h2>
  <p>
    {legal.owner}
    {legal.address && <><br />{legal.address}</>}
    {legal.taxId && <><br />P.IVA / C.F.: {legal.taxId}</>}
    <br />Email: <a href={`mailto:${legal.email}`}>{legal.email}</a>
  </p>

  <h2>Privacy</h2>
  <p>Il trattamento dei dati personali è descritto nell'<a href="/privacy/">informativa privacy</a>.</p>
</LegalLayout>
