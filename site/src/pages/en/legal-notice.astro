---
import LegalLayout from '../../layouts/LegalLayout.astro';
import { legal } from '../../config/legal';
---

<LegalLayout lang="en" title="Legal notice" alternates={{ it: '/note-legali/', en: '/en/legal-notice/' }}>
  <h2>Website owner</h2>
  <p>
    {legal.owner}
    {legal.address && <><br />{legal.address}</>}
    {legal.taxId && <><br />VAT / tax code: {legal.taxId}</>}
    <br />Email: <a href={`mailto:${legal.email}`}>{legal.email}</a>
  </p>

  <h2>Privacy</h2>
  <p>How we handle personal data is explained in our <a href="/en/privacy/">privacy notice</a>.</p>
</LegalLayout>
