---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content } from '../i18n';

const t = content.it;
---

<BaseLayout lang="it" title="Pagina non trovata">
  <Header lang="it" />
  <main class="section">
    <div class="wrap notfound">
      <h1>Pagina non trovata</h1>
      <p>La pagina che cerchi non esiste o è stata spostata.</p>
      <p lang="en">The page you are looking for does not exist or has been moved.</p>
      <div class="ctas">
        <a class="btn btn-primary" href="/">Torna alla home</a>
        <a class="btn btn-ghost" href="/en/">English version</a>
      </div>
    </div>
  </main>
  <Footer t={t} />
</BaseLayout>

<style>
  .notfound {
    max-width: 640px;
    min-height: 40vh;
  }
  p {
    color: var(--muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }
</style>
